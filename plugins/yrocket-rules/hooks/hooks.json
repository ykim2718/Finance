{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cat \"${CLAUDE_PLUGIN_ROOT}/hooks/conversation_rules.md\" \"${CLAUDE_PLUGIN_ROOT}/hooks/skill_loading_rules.md\""
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/update-plugins.sh\"",
            "timeout": 180
          }
        ]
      }
    ]
  }
}
